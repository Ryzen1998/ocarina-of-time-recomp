+        private static Operand EmitGlobalFloatAddCasLoop(EmitterContext context, Operand addrLow, Operand addrHigh, Operand value)
+        {
+            Operand lblLoopHead = Label();
+
+            context.MarkLabel(lblLoopHead);
+
+            Operand oldValue = context.Load(StorageKind.GlobalMemory, addrLow, addrHigh);
+            Operand newValue = context.FPAdd(oldValue, value);
+
+            Operand casResult = context.AtomicCompareAndSwap(StorageKind.GlobalMemory, addrLow, addrHigh, oldValue, newValue);
+
+            context.BranchIfTrue(lblLoopHead, context.ICompareNotEqual(casResult, oldValue));
+
+            return oldValue;
